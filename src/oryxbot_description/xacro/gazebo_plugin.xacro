<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="oryxbot_gazebo_plugin">
  <xacro:macro name="oryxbot_gazebo_plugin">
    <!-- 全向移动驱动 -->
    <gazebo>
      <plugin name="oryxbot_controller" filename="libgazebo_ros_planar_move.so">
        <commandTopic>cmd_vel</commandTopic>
        <odometryTopic>odom</odometryTopic>
        <odometryFrame>odom</odometryFrame>
        <odometryRate>20.0</odometryRate>
        <robotBaseFrame>base_footprint</robotBaseFrame>
      </plugin>
    </gazebo>

    <!-- 材质 -->
    <gazebo reference="base_footprint"><material>Gazebo/GreyTransparent</material></gazebo>
    <gazebo reference="charge_port_link"><material>Gazebo/Orange</material></gazebo>
    <gazebo reference="base_link"><material>Gazebo/White</material></gazebo>
    <gazebo reference="lf/wheel_link"><material>Gazebo/FlatBlack</material></gazebo>
    <gazebo reference="lr/wheel_link"><material>Gazebo/FlatBlack</material></gazebo>
    <gazebo reference="rf/wheel_link"><material>Gazebo/FlatBlack</material></gazebo>
    <gazebo reference="rr/wheel_link"><material>Gazebo/FlatBlack</material></gazebo>
    <gazebo reference="front_lidar_link"><material>Gazebo/BlueLaser</material></gazebo>
    <gazebo reference="rear_lidar_link"><material>Gazebo/BlueLaser</material></gazebo>
    <gazebo reference="gaiban1_link"><material>Gazebo/FlatBlack</material></gazebo>
    <gazebo reference="gaiban2_link"><material>Gazebo/RedGlow</material></gazebo>
    <gazebo reference="jiting_link"><material>Gazebo/RedGlow</material></gazebo>
    <gazebo reference="box_1_link"><material>Gazebo/Blue</material></gazebo>
    <gazebo reference="box_2_link"><material>Gazebo/Blue</material></gazebo>
    <gazebo reference="guoxianhuan_link"><material>Gazebo/FlatBlack</material></gazebo>
    <gazebo reference="control_box_link"><material>Gazebo/white</material></gazebo>

    <!-- 融合激光雷达 (gmapping和导航使用) -->
    <gazebo reference="fuse_lidar_link">
      <sensor type="ray" name="rplidar_sensor">
        <pose>0 0 0 0 0 0</pose>
        <visualize>false</visualize>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.15</min>
            <max>30.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <plugin name="oryxbot_fuse_lidar" filename="libgazebo_ros_laser.so">
          <topicName>/fuse_scan</topicName>
          <frameName>fuse_lidar_link</frameName>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
